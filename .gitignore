# 默认忽略所有
*

# 仅跟踪记忆目录与核心设定
!README.md
!memories/
!memories/**
!SOUL.md
!.gitignore

# 跟踪技能与插件库
!skills/
!skills/**
!plugins/
!plugins/**
!desktop-plugins/
!desktop-plugins/**
!scripts/
!scripts/**
!.github/
!.github/**

# 忽略临时缓存与构建产物
__pycache__/
*.pyc
node_modules/
.pytest_cache/
.coverage

# 严禁跟踪敏感文件与运行时数据
.env*
auth.json
auth/*.json
*.lock
*.db*
*.log
audio_cache/
cache/
logs/
sessions/
tmp/
hermes-agent/
profiles/

# token-stats 插件运行时状态（含账号信息，2026-09-10 起严禁再上传公开分支）
desktop-plugins/token-stats/direct-quota.json
desktop-plugins/token-stats/ovlm-state.json

# skills 运行时台账（含本机绝对路径，2026-09-10 起移出跟踪，仅存本地）
skills/.curator_ledger.jsonl

# 共享 topics 已是 NTFS junction（真源在 shared-agent-memory 仓库 main 分支），严禁跟踪
memories/topics/

# 09-09 memory rewrite backups (local only)
memories/*.bak-20260909
